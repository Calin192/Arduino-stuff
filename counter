

#include "SevSeg.h"
SevSeg sevseg;

int counter = 0;
int buttonPin = A4;
int buttonClear = A5;

bool lastState = HIGH;

bool lastStateC = HIGH;

void setup() {
  byte numDigits = 4;
  byte digitPins[] = {2, 3, 4, 5};
  byte segmentPins[] = {6, 7, 11, 9, 10, 12, 8, 13};

  sevseg.begin(COMMON_CATHODE, numDigits, digitPins, segmentPins, 0);
  sevseg.setBrightness(90);

  pinMode(buttonPin, INPUT_PULLUP);
}

void loop() {
  bool currentState = digitalRead(buttonPin);
  bool currentStateC = digitalRead(buttonClear);

if (lastState == HIGH && currentState == LOW) {
  counter++;
  delay(200); // debounce
}

if (lastStateC == HIGH && currentStateC == LOW) {
  counter = 0;
  delay(200); // debounce
}

  lastState = currentState;
  lastStateC = currentStateC;

  sevseg.setNumber(counter);
  sevseg.refreshDisplay();

  
}
